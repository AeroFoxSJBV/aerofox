# Local inference uses the pinned llama.cpp service. No commercial credentials are used.
AEROFOX_LLM=auto
AEROFOX_MODEL=aerofox-qwen-1.5b
AEROFOX_LLM_URL=http://127.0.0.1:8793
AEROFOX_LLM_TIMEOUT=120
# Visitors wait in a visible queue (position + estimate) instead of falling back to the offline engine.
AEROFOX_LLM_QUEUE_WAIT=240
AEROFOX_LLM_MAX_WAITING=6
AEROFOX_TURN_DEADLINE=300
AEROFOX_LLM_DAILY_TURNS=500
AEROFOX_RATE_PER_MINUTE=12
AEROFOX_TRUST_PROXY=0
AEROFOX_CORS_ORIGINS=
# Conversations survive restarts in this SQLite file ("off" keeps them in memory only).
AEROFOX_SESSION_DB=var/sessions.sqlite3
# Public link used by START_AEROFOX_PUBLICO.bat / scripts/supervisor.py: cloudflare | tailscale | cloudflare-named
AEROFOX_TUNNEL=cloudflare
# Only for cloudflare-named (needs a domain already on Cloudflare). Keep the token in .env only; never commit it.
# CLOUDFLARE_TUNNEL_TOKEN=
# AEROFOX_PUBLIC_URL=https://aerofox.example.org
